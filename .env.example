# AI Radar Environment Variables
# Copy this file to .env and adjust as needed

# Database path (mounted via Docker volume).
# On Windows use an absolute path with a drive letter: a drive-less "/data/..."
# resolves against the drive the process happens to be running from.
DATABASE_URL=file:/data/ai-radar.db
# DATABASE_URL=file:G:/data/ai-radar.db

# AI provider: "ollama" or "openai" (any OpenAI-compatible endpoint)
AI_PROVIDER=openai

# AI server. AI_BASE_URL / AI_MODEL / AI_TIMEOUT are the canonical names;
# OLLAMA_BASE_URL / OLLAMA_MODEL / OLLAMA_TIMEOUT are still read as fallbacks.
# Local Strata server:
AI_BASE_URL=http://localhost:8080
AI_MODEL=qwen3.8-flash-next-iq2_xs
# Ollama (container name when services are on the same network):
# AI_BASE_URL=http://ollama:11434
# AI_MODEL=qwen3.6-35b-a3b-ud-q4_k_m
AI_TIMEOUT=120

# Reasoning models need headroom beyond the answer itself
AI_MAX_TOKENS=2000

# Mock AI is never the default: it must be enabled explicitly
USE_MOCK_AI=false

# Collector settings
SCHEDULE=10:00,15:00
COLLECTOR_TIMEOUT=30

# Next.js settings
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=AI Radar
