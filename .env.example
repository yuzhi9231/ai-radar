# AI Radar Environment Variables
# Copy this file to .env and adjust as needed

# Database path (mounted via Docker volume)
DATABASE_URL=file:/data/ai-radar.db

# Ollama base URL (use container name when services are on the same network)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3.6-35b-a3b-ud-q4_k_m
OLLAMA_TIMEOUT=120

# AI provider: "ollama" or "openai" (any OpenAI-compatible endpoint)
AI_PROVIDER=ollama
# Reasoning models need headroom beyond the answer itself
AI_MAX_TOKENS=2000

# Mock AI is never the default: it must be enabled explicitly
USE_MOCK_AI=false

# Collector settings
SCHEDULE=10:00,15:00
COLLECTOR_TIMEOUT=30

# Next.js settings
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=AI Radar
